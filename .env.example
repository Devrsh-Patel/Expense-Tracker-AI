# Django Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-backend-app.onrender.com,localhost,127.0.0.1

# Database Configuration (MySQL / PostgreSQL / SQLite)
# For managed cloud MySQL (e.g. TiDB Cloud / Aiven):
DB_ENGINE=django.db.backends.mysql
DB_NAME=fintracker_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host.tidbcloud.com
DB_PORT=4000
# Optional SSL Certificate Authority path if required by cloud provider
DB_SSL_CA=

# Or using full connection URL (e.g. on Railway / Render):
# DATABASE_URL=mysql://user:password@host:port/dbname

# CORS and CSRF Settings
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.vercel.app,https://your-backend-app.onrender.com

# External OAuth Integrations
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

